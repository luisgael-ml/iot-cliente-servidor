    },
    {
      "id": 8,
      "type": "table",
      "title": "Últimas alertas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-iot"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-iot"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.creada_en AS hora, s.codigo AS sensor, a.valor, a.umbral, a.atendida\nFROM alertas a JOIN sensores s ON s.id = a.sensor_id\nORDER BY a.creada_en DESC LIMIT 15"
        }
      ]
    }
