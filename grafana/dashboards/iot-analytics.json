    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatura (°C)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-iot"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-iot"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT l.medido_en AS time, s.codigo AS metric, l.valor AS value\nFROM lecturas l JOIN sensores s ON s.id = l.sensor_id\nWHERE $__timeFilter(l.medido_en) AND s.tipo = 'temperatura'\nORDER BY 1"
        }
      ]
    },
    {
