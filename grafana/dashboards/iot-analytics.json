          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT l.medido_en AS time, s.codigo AS metric, l.valor AS value\nFROM lecturas l JOIN sensores s ON s.id = l.sensor_id\nWHERE $__timeFilter(l.medido_en) AND s.tipo = 'vibracion'\nORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
